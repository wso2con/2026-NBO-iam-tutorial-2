# Template for the WhatsApp transport (port 8792). Sourced with `set -a`, so every key
# is exported into the agent process; ai-agent/.env keeps serving the web chat on 8791.
#
# QUOTING: single quotes, always - the secrets contain $ % @ # !.

# --- Demo organization ------------------------------------------------------
# An agent created in one sub-org cannot sign in to another, so changing the org
# means changing the agent and the application below too.
DEMO_ORG_ID='<sub-organization id>'
DEMO_PHONE='<demo handset, digits only>'
ASGARDEO_TENANT='wayfinderenterprise'

# --- Agent identity, native to DEMO_ORG_ID ----------------------------------
# Not shared down from the root org. Holds the WA-Assistant application role.
AGENT_ID='<agent id created inside DEMO_ORG_ID>'
AGENT_SECRET='<agent secret>'

# --- Application owned by DEMO_ORG_ID ---------------------------------------
# Must issue JWT access tokens under the ROOT issuer: mcp/server.ts verifies against
# the root /oauth2/jwks, which does not publish a sub-org's own signing key.
CLIENT_ID='<client id of the sub-org application>'
CLIENT_SECRET=''

# No organization_switch on this path, so the API scopes are requested at sign-in.
AGENT_SIGN_IN_SCOPES='mcp:view_travel_policy'

# Leave commented out - the organization's discovery document states the issuer.
# ASGARDEO_ISSUER=''

# --- Callback URLs ----------------------------------------------------------
# Both must be Authorized Redirect URLs on CLIENT_ID, or startup fails with
# "invalid_callback - callback.not.match".
REDIRECT_URI='http://localhost:8791'
# Tapped from the user's phone, so it must be publicly reachable.
OBO_REDIRECT_URI='https://<your public tunnel>/obo/callback'

# --- WhatsApp channel -------------------------------------------------------
# Setting WHATSAPP_PHONE_NUMBER_ID is what enables the /whatsapp/webhook routes.
WHATSAPP_PHONE_NUMBER_ID='<Meta > WhatsApp > API Setup>'
# Must match the Verify Token in Meta > WhatsApp > Configuration, or the handshake 403s.
WHATSAPP_VERIFY_TOKEN='<any random string, also set in Meta>'
WHATSAPP_TOKEN='<Meta access token>'
WHATSAPP_APP_SECRET='<Meta app secret>'
# Leave true until a permanent Meta System User token is in place.
WHATSAPP_DRY_RUN='true'
WHATSAPP_ORG_MAP='{"<wa_id>":"<organization id>"}'
