# Port used by the MCP server.
MCP_PORT=8001

# Host used by the MCP server.
HOST=localhost

# The MCP server calls the B2B app's service functions directly (DB queries,
# Asgardeo SCIM client) instead of going over REST, so it also needs the
# webapp's Asgardeo/DB configuration. These are loaded automatically from
# ../webapp/.env.local if not set here.
# NEXT_PUBLIC_BASE_URL=https://api.asgardeo.io/t/<your-organization-name>
# USER_STORE_NAME=DEFAULT
# DB_PATH=/var/data/app.db

# Display name(s) for AI agents that book on a user's behalf, used to attribute
# bookings made through the OBO flow. Also loaded from ../webapp/.env.local;
# set them here only to override that for the MCP server.
# AGENT_DISPLAY_NAME=WayFinder Assistant
# AGENT_DISPLAY_NAMES=<agentId>=<Name>,<agentId>=<Name>
# AGENT_DISPLAY_ACCENTS=<agentId>=green,<agentId>=violet
